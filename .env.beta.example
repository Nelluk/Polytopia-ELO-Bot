# This file is for the upstream development beta, not ordinary self-hosting.
# Copy it to .env in the beta checkout. COMPOSE_FILE lets normal
# `docker compose` commands select the beta definition from that directory.
COMPOSE_FILE=compose.beta.yaml
COMPOSE_PROJECT_NAME=polybot-beta

POLYBOT_RUNTIME_UID=1000
POLYBOT_RUNTIME_GID=1000
POLYBOT_BOT_IMAGE=polybot-beta:local

# Set this to the full 40-character clean Git HEAD before every image build.
POLYBOT_SOURCE_CHECKPOINT=REPLACE_WITH_EXACT_CLEAN_GIT_HEAD

POSTGRES_SOCKET_DIR=/var/run/postgresql
POLYBOT_BOT_MEMORY_LIMIT=1g
POLYBOT_BOT_CPU_LIMIT=1.0
