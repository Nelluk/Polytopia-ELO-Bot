[Unit]
Description=Self-hosted PolyBot Discord bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
Group=REPLACE_WITH_SERVICE_GROUP
WorkingDirectory=/opt/polybot
Environment=POLYBOT_ENV=production
ExecStart=/opt/polybot/.venv/bin/python /opt/polybot/bot.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polybot/data/images /opt/polybot/logs

[Install]
WantedBy=multi-user.target
