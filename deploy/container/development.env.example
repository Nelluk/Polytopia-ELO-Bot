# Optional Compose interpolation. Copy to deploy/container/.env only when an
# override is needed; the reviewed defaults are intentionally usable as-is.
POLYBOT_BOT_IMAGE=polybot-development:local
POLYBOT_PYTHON_IMAGE=python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
POLYBOT_UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c
POLYBOT_POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382
POLYBOT_SOURCE_CHECKPOINT=REPLACE_WITH_EXACT_CLEAN_GIT_HEAD
# Set these to the host owner of both private bot configuration files. The
# image remains non-root while retaining access to mode-0600 bind mounts.
POLYBOT_RUNTIME_UID=1000
POLYBOT_RUNTIME_GID=1000
POLYBOT_BOT_MEMORY_LIMIT=1g
POLYBOT_BOT_CPU_LIMIT=1.0
POLYBOT_POSTGRES_MEMORY_LIMIT=768m
POLYBOT_POSTGRES_CPU_LIMIT=1.0
# Set these to the host user/group that owns deploy/container/backups.
POLYBOT_RECOVERY_UID=1000
POLYBOT_RECOVERY_GID=1000
