[Unit]
Description=PolyElo production Discord bot
Wants=network-online.target
After=network-online.target postgresql.service
ConditionPathExists=/srv/polyelo/PolyBot39/.venv/bin/python
ConditionPathExists=/srv/polyelo/PolyBot39/config.ini
ConditionPathExists=/srv/polyelo/PolyBot39/server_settings.py
ConditionPathExists=/srv/polyelo/PolyBot39/spreadsheet_creds.json

[Service]
Type=simple
User=polyelo
Group=polyelo
SupplementaryGroups=polyelo-editors
WorkingDirectory=/srv/polyelo/PolyBot39
Environment=HOME=/srv/polyelo
Environment=POLYBOT_ENV=production
Environment=PATH=/srv/polyelo/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=XDG_CONFIG_HOME=/srv/polyelo/.config
Environment=XDG_CACHE_HOME=/srv/polyelo/.cache
Environment=XDG_DATA_HOME=/srv/polyelo/.local/share
Environment=MPLCONFIGDIR=/srv/polyelo/.cache/matplotlib
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/polyelo/PolyBot39/.venv/bin/python /srv/polyelo/PolyBot39/bot.py
Restart=always
RestartSec=10
UMask=0007

[Install]
WantedBy=multi-user.target
