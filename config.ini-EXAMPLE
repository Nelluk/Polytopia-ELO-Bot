[DEFAULT]
discord_key = YOURAPIKEYHERE
# private token from discord developer porter
expected_bot_id = 484067640302764042
# Discord application/bot ID expected after login
psql_user = nelluk
# username for postgres database
psql_db = polytopia2
# database name
psql_password = CHANGEME
psql_host =
# leave host blank to use PostgreSQL's default local socket
psql_port =
# leave port blank to use PostgreSQL's default
owner_id = 272510639124250625
# discord user ID of bot installation owner. Above default is Nelluk.
superuser_ids =
# optional comma-separated Discord user IDs with cross-guild superuser access.
# The owner_id is always included automatically and need not be repeated.
bullet_enabled = true
# load the Google Sheets-backed Bullet cog
