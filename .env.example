# Compose names this deployment and its resources. Use a different value for
# every independent bot checkout.
COMPOSE_PROJECT_NAME=polybot

# Numeric owner of ./data/images, ./logs, and ./backups on Linux.
POLYBOT_UID=1000
POLYBOT_GID=1000
POLYBOT_IMAGE=polybot:local

# Create this volume explicitly before the first `docker compose up`.
POSTGRES_VOLUME_NAME=polybot-postgres
POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382

# Replace both passwords. POLYBOT_DATABASE_PASSWORD must match psql_password
# in config.ini. These values are private and .env must not be committed.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DISTINCT_ADMIN_PASSWORD
POLYBOT_DATABASE_NAME=polybot
POLYBOT_DATABASE_USER=polybot
POLYBOT_DATABASE_PASSWORD=REPLACE_WITH_THE_CONFIG_INI_DATABASE_PASSWORD

POLYBOT_BACKUP_PREFIX=polybot
