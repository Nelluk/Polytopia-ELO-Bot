# Copy compose.example.yaml to the ignored compose.yaml, then copy this file
# to the ignored .env. Development is the safest initial mode.
COMPOSE_PROJECT_NAME=polybot
POLYBOT_ENV=development

# Numeric runtime identity. On Linux it must be able to write ./backups;
# named volumes initialize from the image's matching ownership.
POLYBOT_UID=1000
POLYBOT_GID=1000
POLYBOT_IMAGE=polybot:local
POLYBOT_CONFIG_FILE=./config.ini
POLYBOT_SERVER_SETTINGS_FILE=./server_settings.py

POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382

# Replace both passwords. This file is the only database-credential authority
# for the recommended Compose deployment and must not be committed.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DISTINCT_ADMIN_PASSWORD
POLYBOT_DATABASE_NAME=polybot_dev
POLYBOT_DATABASE_USER=polybot
POLYBOT_DATABASE_PASSWORD=REPLACE_WITH_A_STRONG_APPLICATION_PASSWORD

POLYBOT_BACKUP_PREFIX=polybot
