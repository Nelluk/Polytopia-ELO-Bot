# Upstream GreenCloud production only. Copy to .env in the production clone.
# Normal operation then uses ordinary `docker compose` commands.
COMPOSE_FILE=compose.production.yaml
COMPOSE_PROJECT_NAME=polyelo-production

# Numeric identity of the existing host `polyelo` service account.
POLYBOT_UID=997
POLYBOT_GID=980

# Update both values for every reviewed production image build.
POLYBOT_IMAGE=polyelo-production:REPLACE_WITH_SHORT_GIT_SHA
POLYBOT_SOURCE_CHECKPOINT=REPLACE_WITH_EXACT_40_CHARACTER_GIT_HEAD

# Host PostgreSQL remains externally managed and private.
POSTGRES_SOCKET_DIR=/var/run/postgresql
