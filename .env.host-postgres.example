# Linux-only Compose deployment using an already managed host PostgreSQL
# server. No database container or volume is created by this deployment.
COMPOSE_PROJECT_NAME=polybot
POLYBOT_UID=1000
POLYBOT_GID=1000
POLYBOT_IMAGE=polybot:local

POSTGRES_SOCKET_DIR=/var/run/postgresql
POLYBOT_DATABASE_NAME=polybot
POLYBOT_DATABASE_USER=polybot
# Leave blank only when config.ini also selects reviewed local peer auth.
POLYBOT_DATABASE_PASSWORD=
POLYBOT_BACKUP_PREFIX=polybot
