[DEFAULT]
guild_configuration_source = static
# Copy this file to config.development.ini and replace every placeholder.
discord_key = YOUR_DEVELOPMENT_BOT_TOKEN
expected_bot_id = 123456789012345678
owner_id = 123456789012345679
superuser_ids =
# optional comma-separated Discord user IDs with cross-guild superuser access.
# The owner_id is always included automatically and need not be repeated.

psql_db = polytopia_dev
psql_user = polybot_dev
psql_password = YOUR_SEPARATE_DEVELOPMENT_DATABASE_PASSWORD
psql_host = localhost
psql_port = 5432

# Optional extra denylist when this checkout cannot read its installation's
# ignored config.ini/server_settings.py. Leave blank for a new standalone
# installation; otherwise use that installation's production identifiers.
production_database_name =
production_bot_id =
production_guild_ids =

# Leave these empty/false unless you explicitly accept a shared-guild risk.
# The exception is exact-ID-only and does not weaken other overlap checks.
shared_production_guild_ids =
acknowledge_shared_production_guild_risk = false

# Both development policies are off by default. Enabling either policy also
# requires its separate allow_development_* acknowledgement to be true.
background_tasks_enabled = false
allow_development_background_tasks = false
api_enabled = false
allow_development_api = false
bullet_enabled = false

image_root = data/development/images
log_root = logs/development
